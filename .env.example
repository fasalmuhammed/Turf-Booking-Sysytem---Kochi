# ---------------------------------------------------------------
# Server
# ---------------------------------------------------------------
PORT=3000
NODE_ENV=development
# Public HTTPS URL of this server (used for payment pages + webhooks).
# For local testing use an ngrok/cloudflared tunnel URL.
PUBLIC_BASE_URL=http://localhost:3000
TZ_NAME=Asia/Kolkata
DATABASE_PATH=./data/turf.db
# Long random string used to sign payment-page links. CHANGE THIS.
APP_SECRET=change-me-to-a-long-random-string

# ---------------------------------------------------------------
# WhatsApp Cloud API (Meta for Developers -> your app -> WhatsApp -> API Setup)
# Set WHATSAPP_MODE=mock to run without Meta credentials (use the
# built-in simulator in the admin dashboard to chat with the bot).
# ---------------------------------------------------------------
WHATSAPP_MODE=mock
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Any string you choose; paste the same value into the Meta webhook config.
WHATSAPP_VERIFY_TOKEN=choose-a-verify-token
# App secret (App settings -> Basic). Used to verify webhook signatures.
WHATSAPP_APP_SECRET=
# Optional approved template for reminders sent outside the 24h window.
# Template body must have 4 params: {{1}} name, {{2}} turf, {{3}} date, {{4}} time
WHATSAPP_REMINDER_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en

# Comma-separated admin WhatsApp numbers (with country code, no +)
# that receive alerts for new payments / human hand-off requests.
ADMIN_WHATSAPP_NUMBERS=

# ---------------------------------------------------------------
# Payments
# UPI details shown to customers are configured in the dashboard
# (Settings). Optionally enable Razorpay for automatic verification.
# ---------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------
# First admin account (created on first start if no admin exists).
# You can also run: npm run create-admin -- <username> <password>
# ---------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Load demo turfs / FAQs on first start when the database is empty
SEED_DEMO_DATA=true
